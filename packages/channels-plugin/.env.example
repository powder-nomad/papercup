# Copy to dispatcher/.env (or export in your shell) before running.
# dispatcher/src/index.ts is the source of truth for the var list.

# --- required for the dispatcher ------------------------------------------

# Discord bot token (Bot tab in dev portal → Reset Token).
DISCORD_BOT_TOKEN=

# --- required only for `npm run register` (one-shot slash-command sync) ---

# Application (Client) ID from the General Information tab in dev portal.
DISCORD_CLIENT_ID=

# Guild snowflake to register the commands in. Use the same guild you'll bind
# channels in. (Global commands would also work but propagate slowly.)
DISCORD_GUILD_ID=

# --- optional -------------------------------------------------------------

# State directory. Defaults to ~/.papercup-channels.
# PAPERCUP_HOME=

# UDS socket path. Defaults to $PAPERCUP_HOME/dispatcher.sock.
# PAPERCUP_DISPATCHER_SOCK=

# Override plugin location (auto-resolved relative to dispatcher by default).
# PAPERCUP_PLUGIN_DIR=

# --add-dir target for the claude child. Without this, claude can only see /tmp.
# PAPERCUP_PROJECT_DIR=/home/papercup/workspaces/papercup

# Idle-reaper threshold (ms). Sessions idle longer than this get their claude
# child SIGTERMed; next inbound message respawns via --resume. Default 30min.
# PAPERCUP_IDLE_TIMEOUT_MS=1800000

# Discord user-id allowlist. Comma-separated snowflakes. When set, only these
# users can post to bound channels AND only these users can answer permission
# prompts. Empty = open (any allowed sender in the channel can reach claude).
# PAPERCUP_ALLOWED_USERS=184695080709324800,221773638772129792

# Bot owner Discord user-id. Required for the scheduler (/cron, /queue,
# /scheduler, /limit-handler). Owner manages anything; allowlist members
# manage their own jobs. Empty = no one is owner (scheduler commands reject).
# BOT_OWNER_ID=

# Context-pressure + auto-compact policy (F4). Thresholds are percentages of
# the model context window — 200k by default, 1M for [1m] / sonnet-4* models.
# Policy modes: auto (warn + auto-fork-and-summarize), warn-only, off.
# PAPERCUP_COMPACT_POLICY=auto
# PAPERCUP_CONTEXT_WARN_PCT=70
# PAPERCUP_CONTEXT_DANGER_PCT=85
# PAPERCUP_AUTOCOMPACT_PCT=92
# PAPERCUP_CONTEXT_SCAN_MS=300000

# Optional absolute floors. When set, warn/danger fire no later than these
# token counts, even if the percent threshold is higher. Auto-compact has no
# absolute floor.
# PAPERCUP_CONTEXT_WARN_TOKENS=150000
# PAPERCUP_CONTEXT_DANGER_TOKENS=180000

# --- voice (Phase 3) ------------------------------------------------------

# TTS engine. "auto" routes per detected language (Kokoro for English, Melo
# for Korean). Set "kokoro" or "melotts" to pin. Voice silently degrades to
# text-only if the engine sidecar can't start.
# PAPERCUP_TTS_ENGINE=auto

# Trailing-silence (ms) that ends an utterance in the Discord receiver
# subscription. Lower = snappier turn-taking, more spurious splits.
# PAPERCUP_SILENCE_MS=600

# Silero speech-probability threshold per 32ms window (0-1).
# PAPERCUP_VAD_THRESHOLD=0.4

# Minimum number of speech windows for an utterance to be transcribed —
# noise / cough / mic-pop filter.
# PAPERCUP_VAD_MIN_SPEECH_WINDOWS=3

# Audio-frame heartbeat (ms): if a voice line received any audio inside this
# window, the reaper skips the session even past PAPERCUP_IDLE_TIMEOUT_MS.
# PAPERCUP_VOICE_HEARTBEAT_MS=60000

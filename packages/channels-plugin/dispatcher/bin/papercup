#!/usr/bin/env bash
# Ops helper for the Papercup bot.
#   bin/papercup start     — launch in background
#   bin/papercup stop      — kill it
#   bin/papercup restart   — stop, then start
#   bin/papercup status    — show pid + uptime
#   bin/papercup logs      — tail -F the log
#   bin/papercup tail [N]  — last N lines (default 50)
#
# We launch the bot inside its own user-level systemd unit
# (`papercup-bot.service`) when systemd-run --user is available, so it lives
# in a separate cgroup from whatever shell/tmux session spawned it. Without
# that, a tmux scope getting OOM-killed by the kernel takes the bot with it
# (we lost a session this way once because the launching shell sat under
# `tmux-spawn-XXXX.scope`). The plain `setsid` path is kept as a fallback
# for hosts without user-level systemd.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

PID_FILE="/home/papercup/.papercup-channels/dispatcher.pid"
LOG_FILE="/home/papercup/.papercup-channels/dispatcher.log"
UNIT_NAME="papercup-bot-channels.service"
mkdir -p "/home/papercup/.papercup-channels"

use_systemd() {
  command -v systemd-run >/dev/null 2>&1 \
    && command -v systemctl >/dev/null 2>&1 \
    && systemctl --user is-system-running >/dev/null 2>&1
}

unit_active() {
  systemctl --user is-active --quiet "$UNIT_NAME" 2>/dev/null
}

unit_pid() {
  systemctl --user show -p MainPID --value "$UNIT_NAME" 2>/dev/null
}

is_running() {
  if use_systemd && unit_active; then
    return 0
  fi
  [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

start() {
  if is_running; then
    echo "already running (pid $(cat "$PID_FILE" 2>/dev/null || unit_pid))"
    return 0
  fi
  if use_systemd; then
    systemd-run --user --quiet --collect --unit="$UNIT_NAME" \
      --working-directory="$ROOT" \
      --setenv="PATH=$PATH" \
      --setenv="HOME=$HOME" \
      --property=StandardOutput="append:$LOG_FILE" \
      --property=StandardError="append:$LOG_FILE" \
      --property=Restart=on-failure \
      --property=RestartSec=3s \
      bash -c 'exec npm start'
    sleep 2
    local pid
    pid="$(unit_pid)"
    if [[ -n "$pid" && "$pid" != "0" ]] && unit_active; then
      echo "$pid" > "$PID_FILE"
      echo "started pid $pid (unit $UNIT_NAME), logging to $LOG_FILE"
    else
      echo "failed to start — see $LOG_FILE and 'systemctl --user status $UNIT_NAME'"
      return 1
    fi
  else
    setsid bash -c "exec npm start >> '$LOG_FILE' 2>&1" </dev/null >/dev/null 2>&1 &
    local pid=$!
    disown
    echo "$pid" > "$PID_FILE"
    sleep 2
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "started pid $pid, logging to $LOG_FILE"
    else
      echo "failed to start — see $LOG_FILE"; return 1
    fi
  fi
}

stop() {
  if use_systemd && unit_active; then
    systemctl --user stop "$UNIT_NAME" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$UNIT_NAME" >/dev/null 2>&1 || true
    rm -f "$PID_FILE"
    echo "stopped"
    return 0
  fi
  if [[ ! -f "$PID_FILE" ]] || ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    rm -f "$PID_FILE"
    echo "not running"
    return 0
  fi
  local pid
  pid=$(cat "$PID_FILE")
  kill "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  echo "stopped"
}

status() {
  if use_systemd && unit_active; then
    local pid
    pid="$(unit_pid)"
    echo "running (pid $pid, unit $UNIT_NAME)"
    ps -o pid,etime,cmd -p "$pid" 2>/dev/null || true
    return 0
  fi
  if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    local pid
    pid=$(cat "$PID_FILE")
    echo "running (pid $pid)"
    ps -o pid,etime,cmd -p "$pid" 2>/dev/null || true
  else
    echo "stopped"
  fi
}

cmd="${1:-status}"
case "$cmd" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)  status ;;
  logs)    touch "$LOG_FILE"; tail -F "$LOG_FILE" ;;
  tail)    n="${2:-50}"; tail -n "$n" "$LOG_FILE" ;;
  *) echo "usage: bin/papercup {start|stop|restart|status|logs|tail [N]}"; exit 2 ;;
esac

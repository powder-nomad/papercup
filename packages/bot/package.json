{
  "name": "@papercup/bot",
  "version": "0.1.0",
  "private": true,
  "description": "Papercup Discord bot — voice-first conversational interface to Claude Code or Codex. Ships as a standalone daemon AND as a Claude Code plugin (.claude-plugin/).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "register": "tsx src/register-commands.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/ciphers": "^1.2.1",
    "@papercup/voice-stack": "*",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "prism-media": "^1.3.5",
    "sodium-native": "^4.3.1"
  }
}

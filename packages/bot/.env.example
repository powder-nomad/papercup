DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional. If set, the bot listens to every message in that one channel
# (no @mention needed) and ignores all other channels. Right-click the channel
# in Discord (with Developer Mode on) → Copy Channel ID.
# If unset, the bot falls back to listening for @mentions across all channels.
BOT_TEXT_CHANNEL_ID=

# Security allowlist. Comma-separated Discord user IDs. When set, only those
# users can /pickup, message the bot, or use any slash command. Everyone else
# gets a refusal (slash) or silent ignore (text). MUST be set before any
# public deployment — without it, anyone with @-mention privilege on your
# server can drive the agent (and via prompt-injection, run code on your
# homelab user). Empty/unset → backward-compat, allow everyone.
BOT_ALLOWED_USERS=

SILENCE_MS=600
VAD_THRESHOLD=0.4
VAD_MIN_SPEECH_WINDOWS=3

# Whisper STT (faster-whisper). base.en + int8 fits 4-core CPU at ~0.3 RTF.
# Bigger models: small.en, medium.en. Use float16/float32 with GPU.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_BEAM=1

# TTS engine. Currently supports: kokoro
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_LANG=en-us

# Speaker agent backend.
#   claude-code   — use the `claude` CLI (uses your Claude Code auth, no API key)
#   codex         — use the `codex` CLI (uses your ChatGPT auth, no API key)
#   anthropic-api — use the Anthropic SDK directly (requires ANTHROPIC_API_KEY)
AGENT_BACKEND=claude-code
AGENT_MODEL=haiku
AGENT_MAX_TOKENS=200

# Codex sandbox: read-only | workspace-write | danger-full-access
CODEX_SANDBOX=read-only

# Only needed if AGENT_BACKEND=anthropic-api
ANTHROPIC_API_KEY=

# Comma-separated absolute paths the speaker agent can read from with its
# Read/Glob/Grep tools. Leave empty to disable file lookups (speaker becomes
# talk-only).
PROJECT_DIRS=

# Override the default toolset. Default: "Read Glob Grep" (read-only). Add
# Bash/Edit/Write at your own risk — the speaker is on the latency-critical
# path, so long-running tools degrade call UX. Heavy work belongs in extensions.
# SPEAKER_TOOLS=Read Glob Grep

# Extension subagent sandboxing. Extensions run unattended in
# data/extensions/<id>/ — defaults below let them work autonomously.
# Tighten before going public:
#   EXTENSION_PERMISSION_MODE=default | acceptEdits | auto | bypassPermissions | plan
#     bypassPermissions (default) skips all checks. default/acceptEdits will
#     ask, but extensions have no human to answer — combine with ALLOWED_TOOLS
#     so they only get pre-approved capabilities.
#   EXTENSION_ALLOWED_TOOLS — space-separated whitelist. Defaults to "default"
#     (full toolset). Tighten e.g. "Read Edit Write Bash(npm *) Bash(git *)".
#   EXTENSION_DISALLOWED_TOOLS — explicit denies. Format same as allowedTools.
#     e.g. "WebFetch Bash(curl *) Bash(rm -rf *)" to block exfiltration + nukes.
# EXTENSION_PERMISSION_MODE=bypassPermissions
# EXTENSION_ALLOWED_TOOLS=default
# EXTENSION_DISALLOWED_TOOLS=
